# Frontend: base URL of the FastAPI backend (backend/). Quote → /api/bookings, contact → /api/contacts.
# Local dev: run `uvicorn main:app --reload` in backend/. If unset in dev, forms run in demo mode.
# Production builds get this from the GitHub repo variable VITE_API_URL.
VITE_API_URL=http://localhost:8000
# Optional: canonical origin for meta tags/sitemap (defaults to the github.io URL).
# SITE_URL=https://example.com
